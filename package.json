{
  "name": "second-cerveau",
  "version": "0.1.0",
  "private": true,
  "description": "Interface de lecture (lecture seule) du Second Cerveau : graphe plein écran et recherche centrée.",
  "license": "MIT",
  "repository": "github:AngelHydro/2nd-Cerveau",
  "engines": { "node": ">=22" },
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node --import tsx server/main.ts",
    "serve": "node --import tsx server/main.ts",
    "test": "vitest run",
    "check:vault": "tsx scripts/check-vault.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@vscode/markdown-it-katex": "^1.1.2",
    "chokidar": "^5.0.0",
    "d3-force": "^3.0.0",
    "fastify": "^5.12.5",
    "graphology": "^0.26.0",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "minisearch": "^7.2.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.2",
    "@types/qrcode-terminal": "^0.12.2",
    "concurrently": "^10.0.5",
    "dompurify": "^3.4.16",
    "mermaid": "^12.0.0",
    "sigma": "^3.0.3",
    "svelte": "^5.57.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
